{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectorthodox.example/schemas/page.schema.json",
  "title": "Page",
  "description": "One file per page in content/pages. The slug decides the address, so a builder can add a page anywhere (for example \"about/chapel\"). Sections render in the order listed; set enabled to false to hide one.",
  "type": "object",
  "required": [
    "slug",
    "title",
    "sections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^$|^[a-z0-9-]+(/[a-z0-9-]+)*$"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "hero",
              "pageHeader",
              "quickLinks",
              "upcomingAnnouncements",
              "notableBurials",
              "historyStory",
              "timeline",
              "founders",
              "gallery",
              "graveSearch",
              "graveRecord",
              "sectionMap",
              "serviceRequestForm",
              "commemorationForm",
              "plotsAvailability",
              "preplanningForm",
              "graveCareForm",
              "donateForm",
              "fundTotals",
              "volunteer",
              "visitingHours",
              "visitingInfo",
              "contact",
              "richText",
              "callToAction",
              "imageCredits",
              "announcementsList",
              "announcementDetail"
            ]
          },
          "id": {
            "type": "string",
            "description": "Anchor id, used by menu links such as services#request."
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "heading": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "intro": {
            "$ref": "common.schema.json#/$defs/localized"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
