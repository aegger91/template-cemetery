{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectorthodox.example/schemas/tokens.schema.json",
  "title": "Design tokens",
  "description": "Colors, fonts, radii, layout and motion. Each value becomes a CSS variable such as --color-green or --font-heading.",
  "type": "object",
  "required": ["color", "font"],
  "properties": {
    "$schema": { "type": "string" },
    "color": {
      "type": "object",
      "required": ["birch", "paper", "stone", "slate", "ink", "green", "gold", "line"],
      "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    },
    "font": {
      "type": "object",
      "required": ["heading", "body"],
      "properties": {
        "heading": { "type": "string" },
        "body": { "type": "string" },
        "displaySlavonic": { "type": "string" },
        "displayGreek": { "type": "string" }
      },
      "additionalProperties": false
    },
    "radius": { "type": "object", "additionalProperties": { "type": "string" } },
    "layout": { "type": "object", "additionalProperties": { "type": "string" } },
    "motion": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
